@using App.Domain.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.EntityFrameworkCore
@model List<App.Domain.Identity.AppUser>
@inject UserManager<AppUser> UserManager
@inject RoleManager<AppRole> RoleManager
@using App.Resources.Views.UserManagement

@{
    ViewData["Title"] = "Users";

    var allRoles = await RoleManager.Roles.OrderBy(r => r.Name).ToListAsync();
}

<h1>@UserManagementIndex.Users</h1>

<table class="table">
    <div class="mb-3">
        <button onclick="filterUsers('all', this)" class="btn btn-sm btn-outline-secondary filter-btn">@UserManagementIndex.All</button>
        <button onclick="filterUsers('active', this)" class="btn btn-sm btn-outline-secondary filter-btn">@UserManagementIndex.Active</button>
        <button onclick="filterUsers('inactive', this)" class="btn btn-sm btn-outline-secondary filter-btn">@UserManagementIndex.Inactive</button>
        <button onclick="sortBySeen(this)" class="btn btn-sm btn-outline-secondary filter-btn">@UserManagementIndex.Last_active</button>
        <button onclick="filterByRole('admin', this)" class="btn btn-sm btn-outline-secondary filter-btn">admin</button>
        <button onclick="filterByRole('billing', this)" class="btn btn-sm btn-outline-secondary filter-btn">billing</button>
        <button onclick="filterByRole('employee', this)" class="btn btn-sm btn-outline-secondary filter-btn">employee</button>
        <button onclick="filterByRole('guest', this)" class="btn btn-sm btn-outline-secondary filter-btn">guest</button>
        <button onclick="filterByRole('instituteadmin', this)" class="btn btn-sm btn-outline-secondary filter-btn">institute admin</button>
        <button onclick="filterByRole('institutemanager', this)" class="btn btn-sm btn-outline-secondary filter-btn">institute manager</button>
        <button onclick="filterByRole('owner', this)" class="btn btn-sm btn-outline-secondary filter-btn">owner</button>
        <button onclick="filterByRole('support', this)" class="btn btn-sm btn-outline-secondary filter-btn">support</button>
        <button onclick="filterByRole('user', this)" class="btn btn-sm btn-outline-secondary filter-btn">user</button>
    </div>
    <div>
        <input placeholder="@UserManagementIndex.Search" oninput="searchUsers(this.value)" class="form-control mb-2"/>
    </div>
    <thead>
    <tr>
        <th>
            @UserManagementIndex.User_Name
        </th>
        <th>@UserManagementIndex.Roles</th>
        <th>@UserManagementIndex.Status</th>
        <th>@UserManagementIndex.Last_active</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        var userRoles = await UserManager.GetRolesAsync(item);
        var isActive = item.LockoutEnd == null || item.LockoutEnd <= DateTimeOffset.UtcNow;
        <tr data-status="@(isActive ? "active" : "inactive")"
            data-roles="@string.Join(" ", userRoles)"
            data-lastseen="@(item.LastSeen?.ToString("yyyy-MM-dd HH:mm") ?? "")"
            data-name="@($"{item.FirstName} {item.LastName} {item.UserName} {item.LastSeen}".ToLower())">
            <td>
                <div>@item.FirstName @item.LastName</div>
                <small class="text-muted">@item.UserName</small>
            </td>
            <td>
                @foreach (var role in userRoles)
                {
                    <span class="badge bg-secondary me-1">@role</span>
                }
            </td>
            <td>
                @if (isActive)
                {
                    <span class="badge bg-success">@UserManagementIndex.Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">@UserManagementIndex.Inactive</span>
                }
            </td>
            <td>
                @if (item.LastSeen == null)
                {
                    <div>@UserManagementIndex.Never</div>
                }
                else
                {
                    @item.LastSeen?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                }
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary "
                   type="button"
                   asp-action="PasswordLink"
                   asp-route-id="@item.Id">@UserManagementIndex.Reset_PWD</a>
                <div class="dropdown d-inline-block ms-1">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside">
                        @UserManagementIndex.Roles
                    </button>
                    <ul class="dropdown-menu">
                        @foreach (var role in allRoles)
                        {
                            <li>
                                @if (userRoles.Any(r => r == role.Name))
                                {
                                    <a asp-action="RoleRemove"
                                       asp-route-userId="@item.Id"
                                       asp-route-role="@role"
                                       class="dropdown-item d-flex align-items-center gap-2">
                                        <span class="text-success fw-500">✓</span>
                                        <span>@role.Name</span>
                                        <small class="text-muted ms-auto">click to remove</small>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="RoleAdd"
                                       asp-route-userId="@item.Id"
                                       asp-route-role="@role"
                                       class="dropdown-item d-flex align-items-center gap-2 text-muted">
                                        <span style="width:12px"></span>
                                        <span>@role.Name</span>
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </td>
            <td>
                @if (isActive)
                {
                    <form asp-action="Deactivate" method="post" class="mb-1">
                        <input type="hidden" name="userId" value="@item.Id"/>
                        <button type="submit" class="btn btn-sm btn-outline-danger">@UserManagementIndex.Deactivate</button>
                    </form>
                }
                else
                {
                    <form asp-action="Activate" method="post">
                        <input type="hidden" name="userId" value="@item.Id"/>
                        <button type="submit" class="btn btn-sm btn-outline-danger">@UserManagementIndex.Actiavte</button>
                    </form>
                }
                <div>
                    <form asp-action="Delete" method="post"
                          onsubmit="return confirm('@UserManagementIndex.Warning')">
                        <input type="hidden" name="userId" value="@item.Id"/>
                        <button type="submit" class="btn btn-sm btn-outline-danger">@UserManagementIndex.Delete</button>
                    </form>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
<script>
    function setActiveButton(clicked) {
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        clicked.classList.add('active');
    }
    function filterUsers(status, btn) {
        setActiveButton(btn);
        document.querySelectorAll('tbody tr').forEach(row => {
            if (status === 'all' || row.dataset.status === status) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function filterByRole(role, btn) {
        setActiveButton(btn);
        document.querySelectorAll('tbody tr').forEach(row => {
            if (row.dataset.roles.includes(role)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function sortBySeen(btn) {
        setActiveButton(btn);
        const tbody = document.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.forEach(row => {row.style.display = '';});
        rows.sort((a, b) => {
            const aVal = a.dataset.lastseen || '';
            const bVal = b.dataset.lastseen || '';
            return bVal.localeCompare(aVal);
        });
        rows.forEach(row => tbody.appendChild(row));
    }
    
    function searchUsers(query){
        const q = query.toLowerCase();
        document.querySelectorAll('tbody tr').forEach(row => {
            if (row.dataset.name.includes(q) || row.dataset.lastseen.includes(q)) {
                row.style.display = '';
            }
            else {
                row.style.display = 'none';
            }
        })
    }
</script>
