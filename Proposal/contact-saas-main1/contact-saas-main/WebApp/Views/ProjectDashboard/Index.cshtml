@model WebApp.ViewModels.ProjectDashboardViewModel
@using App.Resources.Views.ProjectDashboard
@using WebApp.Controllers

@{
    Layout = "_Layout";
}

<!DOCTYPE html>
<html>
<head>
    <title>Project Dashboard</title>
</head>
<body>
    <div class="container-fluid">
        <h1>@ProjectDashboardIndex.Project_Dashboard</h1>
        <p>
            <a asp-controller="Experiment" asp-action="Create" class="btn btn-success">@ProjectDashboardIndex.Create_new_experiment</a>
        </p>
        <div class="row">
            <!-- Left Column - Experiments Table -->
            <div class="col-md-6">
                <h3>@ProjectDashboardIndex.Experiments</h3>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>@ProjectDashboardIndex.Name</th>
                            <th>@ProjectDashboardIndex.Type</th>
                            <th>@ProjectDashboardIndex.Created</th>
                            <th>@ProjectDashboardIndex.Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var experiment in Model.Experiments)
                        {
                            <tr>
                                <td>@experiment.ExperimentName</td>
                                <td>@experiment.ExperimentType?.Name</td>
                                <td>@experiment.CreatedAt.ToShortDateString()</td>
                                <td>
                                    <a asp-controller="Experiment" asp-action="Edit" asp-route-id="@experiment.Id">@ProjectDashboardIndex.Edit</a> |
                                    <a asp-controller="Experiment" asp-action="Details" asp-route-id="@experiment.Id">@ProjectDashboardIndex.Details</a> |
                                    <a asp-controller="Experiment" asp-action="Delete" asp-route-id="@experiment.Id">@ProjectDashboardIndex.Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-md-6">
                <h3>@ProjectDashboardIndex.Schedule</h3>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>@ProjectDashboardIndex.Name</th>
                            <th>@ProjectDashboardIndex.Status</th>
                            <th>@ProjectDashboardIndex.Start_time</th>
                            <th>@ProjectDashboardIndex.End_time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model.Schedules)
                        {
                            <tr>
                                <td>@schedule.ScheduleName</td>
                                <td>@schedule.Status</td>
                                <td>@schedule.StartTime.ToShortDateString()</td>
                                <td>@schedule.EndTime.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>