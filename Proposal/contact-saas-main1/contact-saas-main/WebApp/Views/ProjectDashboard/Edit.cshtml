@model WebApp.ViewModels.ProjectDashboardViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Experiment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
         <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-3">
            <div class="card-body">
                <p class="text-uppercase text-muted small fw-semibold mb-3">Translations</p>

                <ul class="nav nav-tabs mb-4" id="langTabs">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-en">🇬🇧 English</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-et">🇪🇪 Estonian</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-en">
                        <div class="mb-3">
                            <label asp-for="ExperimentRequest.ExperimentNameEn" class="form-label">Project name</label>
                            <input asp-for="ExperimentRequest.ExperimentNameEn" class="form-control" />
                            <span asp-validation-for="ExperimentRequest.ExperimentNameEn" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ExperimentRequest.ExperimentNameEn" class="form-label">Requirements</label>
                            <textarea asp-for="ExperimentRequest.ExperimentNameEn" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="ExperimentRequest.ExperimentNameEn" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-et">
                        <div class="mb-3">
                            <label asp-for="ExperimentRequest.ExperimentNameEt" class="form-label">Project name</label>
                            <input asp-for="ExperimentRequest.ExperimentNameEt" class="form-control" />
                            <span asp-validation-for="ExperimentRequest.ExperimentNameEt" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ExperimentRequest.ExperimentNameEt" class="form-label">Requirements</label>
                            <textarea asp-for="ExperimentRequest.ExperimentNameEt" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="ExperimentRequest.ExperimentNameEt" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <p class="text-uppercase text-muted small fw-semibold mb-3">General</p>

                <div class="mb-3">
                    <label asp-for="ExperimentRequest.ExperimentTypeId" class="form-label">Project type</label>
                    <select asp-for="ExperimentRequest.ExperimentTypeId" class="form-select"
                            asp-items="@(new SelectList(Model.ExperimentTypes, "Id", "Name"))">
                        <option value="">-- Select project type --</option>
                    </select>
                    <span asp-validation-for="ExperimentRequest.ExperimentTypeId" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="ExperimentRequest.ProjectId" class="form-label">Project type</label>
                    <select asp-for="ExperimentRequest.ProjectId" class="form-select"
                            asp-items="@(new SelectList(Model.Projects, "Id", "Name"))">
                        <option value="">-- Select project type --</option>
                    </select>
                    <span asp-validation-for="ExperimentRequest.ProjectId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <input type="submit" value="Update project" class="btn btn-primary" />
        </div>

    </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
