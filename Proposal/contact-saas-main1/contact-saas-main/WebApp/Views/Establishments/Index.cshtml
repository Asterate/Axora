@using App.Resources.Views.Establishments
@model WebApp.ViewModels.EstablishmentsViewModel
@{
    ViewData["Title"] = EstablishmentsIndex.Title;
}

<h1>@ViewData["Title"]</h1>

<div class="establishments-tables">

    <!-- Institutes -->
    <div class="mb-5">
        <h2>@EstablishmentsIndex.Institutes</h2>
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>@EstablishmentsIndex.Name</th>
                    <th>@EstablishmentsIndex.Address</th>
                    <th>@EstablishmentsIndex.Country</th>
                    <th>@EstablishmentsIndex.Phone</th>
                    <th>@EstablishmentsIndex.Active</th>
                    <th>@EstablishmentsIndex.Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Institutes.Any())
                {
                    @foreach (var institute in Model.Institutes)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => institute.InstituteName)</td>
                            <td>@Html.DisplayFor(modelItem => institute.InstituteAddress)</td>
                            <td>@Html.DisplayFor(modelItem => institute.InstituteCountry)</td>
                            <td>@Html.DisplayFor(modelItem => institute.InstitutePhoneNumber)</td>
                            <td>
                                @(institute.Active ? EstablishmentsIndex.Yes : EstablishmentsIndex.No)
                            </td>
                            <td>
                                <a asp-controller="Institute" asp-action="Edit" asp-route-id="@institute.Id" class="btn btn-sm btn-primary">@EstablishmentsIndex.Edit</a>
                                <a asp-controller="Institute" asp-action="Details" asp-route-id="@institute.Id" class="btn btn-sm btn-info">@EstablishmentsIndex.Details</a>
                                <a asp-controller="Lab" asp-action="Delete" asp-route-id="@institute.Id" class="btn btn-sm btn-info">@EstablishmentsIndex.Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-muted">@EstablishmentsIndex.NoInstitutesFound</td></tr>
                }
            </tbody>
        </table>
        <a asp-controller="Institute" asp-action="Create" class="btn btn-success">@EstablishmentsIndex.AddNewInstitute</a>
    </div>



</div>
