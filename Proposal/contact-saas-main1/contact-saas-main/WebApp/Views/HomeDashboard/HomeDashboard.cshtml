@using App.Modules.Project.Application.DTO
@using App.Resources.Views.HomeDashboard
@model IEnumerable<App.Modules.Project.Application.DTO.ProjectListResponse>

@{
    Layout = "_Layout";
    var items = Model?.ToList() ?? new List<ProjectListResponse>();
}

<!DOCTYPE html>
<html >
<head>
    <title>Institute name</title>
</head>
<body>
<div class="container-fluid">
    <h1>@HomeDashboard.Projects</h1>
    <p>
        <a asp-controller="HomeDashboard" asp-action="Create" class="btn btn-success">@HomeDashboard.Create_new_Project</a>
    </p>
    <partial name="_ProjectList" model="items" />
</div>
</body>
</html>