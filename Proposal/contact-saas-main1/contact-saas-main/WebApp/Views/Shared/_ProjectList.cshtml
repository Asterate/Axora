@model IEnumerable<App.Modules.Project.Application.DTO.ProjectResponse>

@{
    var items = Model;
}

<table class="table">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(m => m.First().ProjectName)</th>
        <th>@Html.DisplayNameFor(m => m.First().Funding)</th>
        <th>@Html.DisplayNameFor(m => m.First().Requirements)</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in items) {
        <tr>
            <td>@Html.DisplayFor(_ => item.ProjectName)</td>
            <td>@Html.DisplayFor(_ => item.Funding)</td>
            <td>@Html.DisplayFor(_ => item.Requirements)</td>
            <td>
                <a asp-controller="Project" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-controller="Project" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-controller="Project" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>