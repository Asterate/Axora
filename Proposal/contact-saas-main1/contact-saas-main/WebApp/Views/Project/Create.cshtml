@model WebApp.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Project</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Request.ProjectName" class="control-label"></label>
                <input asp-for="Request.ProjectName" class="form-control" />
                <span asp-validation-for="Request.ProjectName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Request.Funding" class="control-label"></label>
                <input asp-for="Request.Funding" class="form-control" />
                <span asp-validation-for="Request.Funding" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Request.Requirements" class="control-label"></label>
                <input asp-for="Request.Requirements" class="form-control" />
                <span asp-validation-for="Request.Requirements" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Request.RequirementsFilePath" class="control-label"></label>
                <input asp-for="Request.RequirementsFilePath" class="form-control" />
                <span asp-validation-for="Request.RequirementsFilePath" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Request.ProjectTypeId" class="control-label"></label>
                <select asp-for="Request.ProjectTypeId" class="form-control"
                        asp-items="@(new SelectList(Model.ProjectTypes, "Id", "Name"))">
                    <option value="">-- Select Project Type --</option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
