@model WebApp.ViewModels.AnalysisDashboardViewModel
@using App.Resources.Views.AnalysisDashboard
@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title>Analysis Dashboard</title>
</head>
<body>
<div class="col-md-12">
    <h3>@AnalysisDashboardIndex.Results</h3>
    <p>
        <a asp-controller="Result" asp-action="Create" class="btn btn-success">@AnalysisDashboardIndex.Create_new_results</a>
    </p>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@AnalysisDashboardIndex.Name</th>
            <th>@AnalysisDashboardIndex.Description</th>
            <th>@AnalysisDashboardIndex.Created</th>
            <th>@AnalysisDashboardIndex.Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var result in Model.Results)
        {
            <tr>
                <td>@result.ResultName</td>
                <td>@result.ResultDescription</td>
                <td>@result.CreatedAt.ToShortDateString()</td>
                <td>
                    <a asp-controller="Result" asp-action="Edit" asp-route-id="@result.Id">@AnalysisDashboardIndex.Edit</a> |
                    <a asp-controller="Result" asp-action="Details" asp-route-id="@result.Id">@AnalysisDashboardIndex.Details</a> |
                    <a asp-controller="Result" asp-action="Delete" asp-route-id="@result.Id">@AnalysisDashboardIndex.Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
</body>
</html>