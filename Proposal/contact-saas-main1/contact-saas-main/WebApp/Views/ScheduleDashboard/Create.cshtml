@model WebApp.ViewModels.ScheduleDashboardViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Schedule</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-3">
            <div class="card-body">
                <p class="text-uppercase text-muted small fw-semibold mb-3">Translations</p>

                <ul class="nav nav-tabs mb-4" id="langTabs">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-en">🇬🇧 English</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-et">🇪🇪 Estonian</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-en">
                        <div class="mb-3">
                            <label asp-for="ScheduleRequest.ScheduleNameEn" class="form-label">Project name</label>
                            <input asp-for="ScheduleRequest.ScheduleNameEn" class="form-control" />
                            <span asp-validation-for="ScheduleRequest.ScheduleNameEn" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ScheduleRequest.ColorCodeEn" class="form-label">Requirements</label>
                            <textarea asp-for="ScheduleRequest.ColorCodeEn" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="ScheduleRequest.ColorCodeEn" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-et">
                        <div class="mb-3">
                            <label asp-for="ScheduleRequest.ScheduleNameEt" class="form-label">Project name</label>
                            <input asp-for="ScheduleRequest.ScheduleNameEt" class="form-control" />
                            <span asp-validation-for="ScheduleRequest.ScheduleNameEt" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ScheduleRequest.ColorCodeEt" class="form-label">Requirements</label>
                            <textarea asp-for="ScheduleRequest.ColorCodeEt" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="ScheduleRequest.ColorCodeEt" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <p class="text-uppercase text-muted small fw-semibold mb-3">General</p>

                <div class="mb-3">
                    <label asp-for="ScheduleRequest.LabId" class="form-label">Project type</label>
                    <select asp-for="ScheduleRequest.LabId" class="form-select"
                            asp-items="@(new SelectList(Model.Labs, "Id", "Name"))">
                        <option value="">-- Select project type --</option>
                    </select>
                    <span asp-validation-for="ScheduleRequest.LabId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ScheduleRequest.EquipmentId" class="form-label">Project type</label>
                    <select asp-for="ScheduleRequest.EquipmentId" class="form-select"
                            asp-items="@(new SelectList(Model.Equipments, "Id", "Name"))">
                        <option value="">-- Select project type --</option>
                    </select>
                    <span asp-validation-for="ScheduleRequest.EquipmentId" class="text-danger"></span>
                </div> 
                <div class="mb-3">
                    <label asp-for="ScheduleRequest.ExperimentId" class="form-label">Project type</label>
                    <select asp-for="ScheduleRequest.ExperimentId" class="form-select"
                            asp-items="@(new SelectList(Model.Experiments, "Id", "Name"))">
                        <option value="">-- Select project type --</option>
                    </select>
                    <span asp-validation-for="ScheduleRequest.ExperimentId" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ScheduleRequest.Status" class="form-label">Funding</label>
                        <input asp-for="ScheduleRequest.Status" class="form-control" />
                        <span asp-validation-for="ScheduleRequest.Status" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ScheduleRequest.ScheduleStartTime" class="form-label">Start time</label>
                        <input asp-for="ScheduleRequest.ScheduleStartTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ScheduleRequest.ScheduleStartTime" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ScheduleRequest.ScheduleEndTime" class="form-label">End time</label>
                        <input asp-for="ScheduleRequest.ScheduleEndTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ScheduleRequest.ScheduleEndTime" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <input type="submit" value="Create project" class="btn btn-primary" />
        </div>

    </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
