@model WebApp.ViewModels.ScheduleDashboardViewModel
@using App.Resources.Views.ScheduleDashboard

@{
    Layout = "_Layout";
}

<!DOCTYPE html>
<html>
<head>
    <title>Schedule Dashboard</title>
</head>
<body>
    <div class="container-fluid">
        <h1>@ScheduleDashboardIndex.Schedule_Dashboard</h1>
        <p>
            <a asp-controller="ScheduleDashboard" asp-action="Create" class="btn btn-success">@ScheduleDashboardIndex.Create_new_schedule</a>
        </p>
        <div class="row">
            <div class="col-md-12">
                <h3>@ScheduleDashboardIndex.Schedule</h3>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>@ScheduleDashboardIndex.Name</th>
                            <th>@ScheduleDashboardIndex.Status</th>
                            <th>@ScheduleDashboardIndex.Start_Time</th>
                            <th>@ScheduleDashboardIndex.End_Time</th>
                            <th>@ScheduleDashboardIndex.Task</th>
                            <th>@ScheduleDashboardIndex.Lab</th>
                            <th>@ScheduleDashboardIndex.Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model.Schedules)
                        {
                            <tr>
                                <td>@schedule.ScheduleName</td>
                                <td>@schedule.Status</td>
                                <td>@schedule.ExperimentTaskName</td>
                                <td>@schedule.ScheduleStartTime.ToShortDateString()</td>
                                <td>@schedule.ScheduleEndTime.ToShortDateString()</td>
                                <td>
                                    <a asp-controller="ScheduleDashboard" asp-action="Edit" asp-route-id="@schedule.Id">@ScheduleDashboardIndex.Edit</a> |
                                    <a asp-controller="ScheduleDashboard" asp-action="Details" asp-route-id="@schedule.Id">@ScheduleDashboardIndex.Details</a> |
                                    <a asp-controller="ScheduleDashboard" asp-action="Delete" asp-route-id="@schedule.Id">@ScheduleDashboardIndex.Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
