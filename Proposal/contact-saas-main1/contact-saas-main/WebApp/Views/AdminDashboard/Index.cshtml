@model WebApp.ViewModels.AdminDashboardViewModel
@using App.Resources.Views.AdminDashboard
@{
    ViewData["Title"] = @AdminDashboardIndex.Admin_Dashboard;
}

<h1>@ViewData["Title"]</h1>

<h3>@AdminDashboardIndex.Overall_stats</h3>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@AdminDashboardIndex.Total_users</h5>
                <p class="card-text display-4">@Model.TotalUsers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@AdminDashboardIndex.Total_institutes</h5>
                <p class="card-text display-4">@Model.TotalInstitutes</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@AdminDashboardIndex.Total_labs</h5>
                <p class="card-text display-4">@Model.TotalLabs</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@AdminDashboardIndex.Total_Projects</h5>
                <p class="card-text display-4">@Model.TotalProjects</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-5">
    <h4>Logs</h4>
    <div>
        <input placeholder="@AdminDashboardIndex.Search" oninput="searchLogs(this.value)" class="form-control mb-2"/>
    </div>
    <div class="mb-2">
        <button onclick="filterLogs('all')" class="btn btn-sm btn-outline-secondary filter-btn">All</button>
        <button onclick="filterLogs('error')" class="btn btn-sm btn-outline-secondary filter-btn">Errors</button>
        <button onclick="filterLogs('activity')" class="btn btn-sm btn-outline-secondary filter-btn">Activity</button>
    </div>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Timestamp</th>
            <th>Type</th>
            <th>Message</th>
            <th>User</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody id="logs-tbody">
        @if (Model.RecentLogs.Any())
        {
            @foreach (var log in Model.RecentLogs)
            {
                <tr data-type="@log.Type"
                    data-name="@($"{log.Message} {log.Timestamp} {log.StatusCode} {log.UserName} {log.Type}".ToLower())">
                    <td>@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (log.Type == "error")
                        {
                            <span class="badge bg-danger">Error</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Activity</span>
                        }
                    </td>
                    <td>@log.Message</td>
                    <td>@(log.UserName ?? "-")</td>
                    <td>@(log.StatusCode.ToString() ?? "-")</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5" class="text-muted">No logs yet.</td></tr>
        }
        </tbody>
    </table>
</div>
<script>
    function filterLogs(type) {
        document.querySelectorAll('#logs-tbody tr').forEach(row => {
            if (type === 'all' || row.dataset.type === type) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }function searchLogs(query) {
        const q = query.toLowerCase();
        document.querySelectorAll('tbody tr').forEach(row => {
            if (!row.dataset.name || row.dataset.name.includes(q)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>