@model WebApp.ViewModels.DocumentationViewModel
@using Index = App.Resources.Views.DocumentDashboard.Index
@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title>Document Dashboard</title>
</head>
<body>
<div class="col-md-12">
    <h3>@Index.Documents</h3>
    <p>
        <a asp-controller="Document" asp-action="Create" class="btn btn-success">@Index.Create_new_document</a>
    </p>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@Index.Name</th>
            <th>@Index.Type</th>
            <th>@Index.Created</th>
            <th>@Index.Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var document in Model.Documents)
        {
            <tr>
                <td>@document.DocumentName</td>
                <td>@document.DocumentType?</td>
                <td>@document.CreatedAt.ToShortDateString()</td>
                <td>
                    <a asp-controller="Document" asp-action="Edit" asp-route-id="@document.Id">@Index.Edit</a> |
                    <a asp-controller="Document" asp-action="Details" asp-route-id="@document.Id">@Index.Details</a> |
                    <a asp-controller="Document" asp-action="Delete" asp-route-id="@document.Id">@Index.Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
</body>
</html>