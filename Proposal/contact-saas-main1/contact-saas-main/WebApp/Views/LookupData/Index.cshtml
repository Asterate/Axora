@model WebApp.ViewModels.LookupDataViewModel
@using App.Resources.Views.LookupData

@{
    ViewData["Title"] = @LookupDataIndex.Lookup_Data;
}

<h1>@ViewData["Title"]</h1>

<div class="lookup-tables">

    <!-- Document Types -->
    <div class="mb-5">
        <h2>@LookupDataIndex.Document_Types</h2>
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>@LookupDataIndex.Name</th>
                    <th>@LookupDataIndex.Description</th>
                    <th>@LookupDataIndex.Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DocumentTypes.Any())
                {
                    @foreach (var item in Model.DocumentTypes)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>
                                <a asp-controller="DocumentType" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">@LookupDataIndex.Edit</a>
                                <a asp-controller="DocumentType" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">@LookupDataIndex.Details</a>
                                <a asp-controller="DocumentType" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-info">@LookupDataIndex.Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-muted">@LookupDataIndex.Not_found</td></tr>
                }
            </tbody>
        </table>
        <a asp-controller="DocumentType" asp-action="Create" class="btn btn-success">@LookupDataIndex.Add_new_document_type</a>
    </div>

