    </div>

</div>
<script>
    function searchTypes(query) {
        const q = query.toLowerCase();
        document.querySelectorAll('tbody tr').forEach(row => {
            if (!row.dataset.name || row.dataset.name.includes(q)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>